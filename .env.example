# Public Supabase project settings.
# Use the Project URL and public anon/publishable key only.
# Never put a service-role key in a VITE_ variable or frontend file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional public switch: allow isolated, temporary sample data in production.
# npm run build:demo enables it automatically for the presentation build.
VITE_ENABLE_DEMO=false
